# Copy to .env and fill in. .env is gitignored; this template is committed.

# Durable host path mounted as the encrypted vault directory.
VAULT_DIR=./data

# Docker network name other services attach to (external).
DOCKER_NETWORK=tinydb-net

# Encryption key + API token — export in your shell or set here (never commit real values).
# TINYDB_ENC_KEY=
# SECRET_STORE_TOKEN=

# credentials (default) | tokenization
# SERVICE_MODE=credentials
